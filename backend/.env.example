# =============================================================================
# AutoInsta — backend (copie para backend/.env e preencha). NUNCA versione o .env.
# =============================================================================

# development | production
APP_ENV=development
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LOG_LEVEL=INFO

# URL pública do frontend e origens permitidas no CORS (separadas por vírgula)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Supabase ---------------------------------------------------------------
# Conexão Postgres (Dashboard > Connect). Em hosts sem IPv6 use o "Session pooler" (porta 5432).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DB_POOL_MAX_SIZE=5
# URL do projeto (usada para validar os JWTs do Supabase Auth via JWKS)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Somente se o projeto ainda usa o segredo JWT HS256 legado (Settings > JWT Keys)
SUPABASE_JWT_SECRET=

# --- Meta / Instagram API with Instagram Login -------------------------------
# Painel do app > Instagram > API setup with Instagram business login
META_APP_ID=
META_APP_SECRET=
# Deve ser IDÊNTICA à cadastrada em "Business login settings > OAuth redirect URIs"
META_REDIRECT_URI=http://localhost:5173/instagram/callback
# Texto aleatório que você também informa no painel ao configurar o webhook
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Opcional: outros segredos aceitos na assinatura X-Hub-Signature-256 (ex.: App Secret do app Meta)
META_WEBHOOK_EXTRA_SECRETS=

# Criptografia dos tokens OAuth em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30

# --- Rate limiting -------------------------------------------------------------
# memory:// é por processo. Com várias instâncias, use um storage compartilhado (ex.: redis://...)
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per minute

# --- Worker -----------------------------------------------------------------------
# true = roda o worker dentro da API (planos sem background worker, ex.: Render free).
# false = rode `python worker.py` como processo separado (recomendado em produção).
EMBEDDED_WORKER=false

# --- Testes ---------------------------------------------------------------------
# Banco DESCARTÁVEL (é apagado a cada execução da suíte)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/autoinsta_test
