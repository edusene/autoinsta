# =============================================================================
# AutoInsta — arquivo ÚNICO de configuração
#   Local:   este arquivo (.env na raiz do projeto)
#   Render:  Web Service > Environment > "Add from .env" > cole o conteúdo
#   VPS:     docker compose lê este arquivo
# MODELO versionado no Git: NUNCA coloque valores reais aqui. Copie para .env.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
# production no Render/VPS; development na sua máquina
APP_ENV=development
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
# true = worker roda dentro da API (Render free). Na VPS use false + `python worker.py`
EMBEDDED_WORKER=false

# Endereço público do serviço (API e painel ficam no MESMO endereço)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Supabase ----------------------------------------------------------------
# Connect > pooler (URI com a senha do banco)
DATABASE_URL=
DB_POOL_MAX_SIZE=5
# Project Settings > Data API > Project URL
SUPABASE_URL=
# Project Settings > API Keys > Publishable key (sb_publishable_...) ou anon.
# Chave PÚBLICA. NUNCA coloque aqui a secret/service_role.
SUPABASE_ANON_KEY=

# --- Meta / Instagram ----------------------------------------------------------
# developers.facebook.com > seu app > Casos de uso > API setup with Instagram login
#   META_APP_ID     = "ID do app do Instagram"
#   META_APP_SECRET = "Chave secreta do app do Instagram"
META_APP_ID=
META_APP_SECRET=
# Cole no painel da Meta: Login comercial do Instagram > URL de redirecionamento
META_REDIRECT_URI=http://localhost:5173/instagram/callback
# Cole no painel da Meta: Configurar webhooks > Verify token
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
# Só se a validação do webhook falhar: App Secret de "Configurações do app > Básico"
META_WEBHOOK_EXTRA_SECRETS=

# --- Segurança -------------------------------------------------------------------
# Criptografa os tokens do Instagram no banco. NÃO troque depois de conectar contas.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- OpenAI -----------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-6-luna

# --- Testes (só local) --------------------------------------------------------------
# Banco DESCARTÁVEL, apagado a cada execução da suíte
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/autoinsta_test
